module mux2to1(in,sel,out);
  input [1:0]in;
  input sel;
  output out;
  wire w1,w2,w3;
  not g4 (w2,sel);
  and g1(w1,in[0],w2);
  and g2(w3,in[1],sel);
  or g3(out,w1,w3);
endmodule

module mux4to1 (in,sel,out1);
  input [3:0]in;
  input [1:0]sel;
  output out1;
  wire w5,w6;
  mux2to1 g1(in[3:2],sel[1],w5);
  mux2to1 g2(in[1:0],sel[1],w6);
  mux2to1 g3({w5,w6},sel[0],out1);
endmodule

module top(in,sel,out);
  input [15:0]in;
  input [3:0]sel;
  output out;
  wire w1,w2,w3,w4;
  mux4to1 g1(in[3:0],sel[3:2],w1);
  mux4to1 g2(in[7:4],sel[3:2],w2);
  mux4to1 g3(in[11:8],sel[3:2],w3);
  mux4to1 g4(in[15:12],sel[3:2],w4);
  mux4to1 g5({w1,w2,w3,w4},sel[1:0],out);
endmodule
